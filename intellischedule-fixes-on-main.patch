@@ -0,0 +1,114 @@
+import { rawFetch } from '../scripts/testHttp';
+import test from 'node:test';
+import assert from 'node:assert';
+
+const BASE_URL = process.env.BASE_URL || 'http://127.0.0.1:3000';
+const JSON_HEADERS = { 'Content-Type': 'application/json' };
+const CSRF = { 'X-Requested-With': 'intellischedule' };
+
+async function demoLogin(roleKey: string) {
+ const res = await rawFetch(`${BASE_URL}/api/auth/demo-login`, {
+ method: 'POST',
+ headers: { ...JSON_HEADERS, ...CSRF },
+ body: JSON.stringify({ roleKey }),
+ });
+ const body: any = await res.json().catch(() => ({}));
+ const setCookie = (res.headers as any).getSetCookie?.() as string[] | undefined;
+ const raw = (setCookie || []).find(c => c.startsWith('intellischedule_session='));
+ return { res, body, raw, cookie: raw ? raw.split(';')[0] : '' };
+}
+
+test('CSRF: state-changing request without the custom header is rejected', async () => {
+ const res = await rawFetch(`${BASE_URL}/api/auth/login`, {
+ method: 'POST',
+ headers: JSON_HEADERS,
+ body: JSON.stringify({ email: 'nobody@thapar.edu', password: 'x' }),
+ });
+ assert.strictEqual(res.status, 403);
+});
+
+test('CSRF: foreign Origin is rejected even with the header', async () => {
+ const res = await rawFetch(`${BASE_URL}/api/auth/login`, {
+ method: 'POST',
+ headers: { ...JSON_HEADERS, ...CSRF, Origin: 'https://evil.example' },
+ body: JSON.stringify({ email: 'nobody@thapar.edu', password: 'x' }),
+ });
+ assert.strictEqual(res.status, 403);
+ assert.strictEqual(res.headers.get('access-control-allow-origin'), null);
+});
+
+test('CSRF: correct header passes the CSRF gate and GET needs no header', async () => {
+ const post = await rawFetch(`${BASE_URL}/api/auth/login`, {
+ method: 'POST',
+ headers: { ...JSON_HEADERS, ...CSRF },
+ body: JSON.stringify({ email: 'nobody@thapar.edu', password: 'wrong-password' }),
+ });
+ assert.notStrictEqual(post.status, 403);

+ const get = await rawFetch(`${BASE_URL}/api/health/live`);
+ assert.strictEqual(get.status, 200);
+});
+
+test('Unknown /api route returns JSON 404 (not the SPA page)', async () => {
+ const res = await rawFetch(`${BASE_URL}/api/auth/google/debug`);
+ assert.strictEqual(res.status, 404);
+ assert.match(res.headers.get('content-type') || '', /application\/json/);
+});
+
+test('Sessions are cookie-only: no token in the JSON body, cookie is httpOnly, Bearer is ignored', async () => {
+ const { res, body, raw, cookie } = await demoLogin('Student');
+ assert.strictEqual(res.status, 200, JSON.stringify(body));
+ assert.strictEqual('token' in body, false, 'login response must not contain a token');
+ assert.ok(raw, 'session cookie must be set');
+ assert.match(raw!, /HttpOnly/i);
+ assert.match(raw!, /SameSite=Lax/i);
+
+ const sessionValue = cookie.split('=')[1];
+ const viaBearer = await rawFetch(`${BASE_URL}/api/auth/me`, {
+ headers: { Authorization: `Bearer ${sessionValue}` },
+ });
+ assert.strictEqual(viaBearer.status === 401 || (await viaBearer.json().catch(() => ({}))).authenticated !== true, true);
+
+ const viaCookie = await rawFetch(`${BASE_URL}/api/auth/me`, { headers: { Cookie: cookie } });
+ assert.strictEqual(viaCookie.status, 200);
+});
+
+test('Students only receive their own, allowlisted academic data', async () => {
+ const { cookie } = await demoLogin('Student');
+ assert.ok(cookie, 'student session');
+ const H = { Cookie: cookie };
+
+ const boot: any = await (await rawFetch(`${BASE_URL}/api/academic/bootstrap`, { headers: H })).json();
+ assert.strictEqual(boot.success, true);
+ assert.ok((boot.students || []).length <= 1, 'at most the student\'s own record');
+ assert.deepStrictEqual(boot.auditLogs, []);
+ assert.deepStrictEqual(boot.versions, []);
+ assert.deepStrictEqual(boot.makeupTasks, []);
+ for (const f of boot.facultyMembers || []) {
+ assert.strictEqual('email' in f, false, 'faculty email must not be exposed');
+ assert.strictEqual('employeeId' in f, false, 'faculty employee id must not be exposed');
+ }
+
+ const fac: any = await (await rawFetch(`${BASE_URL}/api/academic/faculty`, { headers: H })).json();
+ for (const f of fac.facultyMembers || []) {
+ assert.strictEqual('email' in f, false);

+ assert.strictEqual('employeeId' in f, false);
+ }
+
+ assert.strictEqual((await rawFetch(`${BASE_URL}/api/students`, { headers: H })).status, 403);
+ assert.strictEqual((await rawFetch(`${BASE_URL}/api/timetable/versions`, { headers: H })).status, 403);
+ assert.strictEqual((await rawFetch(`${BASE_URL}/api/timetable/benchmark`, { headers: H })).status, 403);
+});
+
+test('Anonymous requests to data routes are rejected', async () => {
+ for (const path of ['/api/students', '/api/academic/bootstrap', '/api/academic/faculty', '/api/timetable/versions', '/api/notifications']) {
+ const res = await rawFetch(`${BASE_URL}${path}`);
+ assert.strictEqual(res.status, 401, `${path} must require authentication`);
+ }
+});
+
+test('/api/me never invents profile data for an unlinked user', async () => {
+ const { cookie } = await demoLogin('Coordinator');
+ const me: any = await (await rawFetch(`${BASE_URL}/api/me`, { headers: { Cookie: cookie } })).json();
+ assert.notStrictEqual(me.user?.rollNumber, '102303999');
+ assert.notStrictEqual(me.user?.section, 'CSE-A', 'section must come from a real record');
+});

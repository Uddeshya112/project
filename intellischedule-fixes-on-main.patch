diff --git a/scripts/testHttp.ts b/scripts/testHttp.ts
new file mode 100644
index 0000000..320f8b0
--- /dev/null
+++ b/scripts/testHttp.ts
@@ -0,0 +1,59 @@
+/**
+ * Test-only HTTP helper.
+ *
+ * The server authenticates ONLY with the httpOnly `intellischedule_session` cookie and
+ * requires the `X-Requested-With: intellischedule` CSRF header on state-changing requests.
+ * Our test scripts model several users at once, so this shim:
+ * 1. adds the CSRF header to non-GET requests,
+ * 2. maps `Authorization: Bearer <sessionId>` to the session cookie (test convenience only), and
+ * 3. exposes the session id from `Set-Cookie` as `token` on parsed JSON so a script can reuse it.
+ *
+ * Use `rawFetch` when a test must exercise the server without these conveniences.
+ */
+export const rawFetch: typeof fetch = globalThis.fetch.bind(globalThis);
+
+const COOKIE_NAME = 'intellischedule_session';

+
+function extractSessionCookie(res: Response): string | null {
+ const getSetCookie = (res.headers as unknown as { getSetCookie?: () => string[] }).getSetCookie;
+ const cookies = typeof getSetCookie === 'function' ? getSetCookie.call(res.headers) : [];
+ for (const raw of cookies) {
+ const match = raw.match(new RegExp(`^${COOKIE_NAME}=([^;]*)`));
+ if (match && match[1]) return decodeURIComponent(match[1]);
+ }
+ return null;
+}
+
+if (!(globalThis as { __testHttpInstalled?: boolean }).__testHttpInstalled) {
+ (globalThis as { __testHttpInstalled?: boolean }).__testHttpInstalled = true;
+ globalThis.fetch = async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+ const headers = new Headers(init?.headers);
+ const method = (init?.method || (input instanceof Request ? input.method : 'GET')).toUpperCase();
+
+ if (method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS' && !headers.has('x-requested-with')) {
+ headers.set('X-Requested-With', 'intellischedule');
+ }
+
+ const auth = headers.get('authorization');
+ if (auth && /^Bearer\s+/i.test(auth)) {
+ headers.delete('authorization');
+ const existing = headers.get('cookie');
+ const sessionPart = `${COOKIE_NAME}=${encodeURIComponent(auth.replace(/^Bearer\s+/i, '').trim())}`;
+ headers.set('cookie', existing ? `${existing}; ${sessionPart}` : sessionPart);
+ }
+
+ const res = await rawFetch(input, { ...init, headers });
+ const sessionId = extractSessionCookie(res);
+ if (sessionId) {
+ const originalJson = res.json.bind(res);
+ res.json = async () => {
+ const data = await originalJson();
+ if (data && typeof data === 'object' && !Array.isArray(data)) {
+ (data as Record<string, unknown>).token = sessionId;
+ }
+ return data;
+ };
+ }
+ return res;
+ };
+}

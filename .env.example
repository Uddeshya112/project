# Required runtime configuration
APP_URL="https://tiet-timetable-six.vercel.app"
ALLOWED_ORIGINS="https://tiet-timetable-six.vercel.app,http://localhost:3000,http://127.0.0.1:3000"
DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----<Supabase CA>-----END CERTIFICATE-----"

# Optional AI integration
GEMINI_API_KEY=""

# Institutional authentication
ALLOWED_EMAIL_DOMAINS="thapar.edu"
SESSION_TTL_HOURS="24"
BCRYPT_ROUNDS="12"
LOGIN_RATE_LIMIT_PER_IP="300"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://tiet-timetable-km8w.onrender.com/api/auth/google/callback"

# Password recovery. Required in production.
RESET_MAIL_WEBHOOK_URL=""
RESET_MAIL_WEBHOOK_TOKEN=""

# Development/demo only. Keep false/unset in production.
DEMO_MODE="false"
SEED_DEMO_DATA="false"
SEED_SAMPLE_USERS="true"
SAMPLE_ACCOUNTS_PASSWORD=""
DEMO_ACCOUNTS_PASSWORD=""

# Test-only reset token access
ALLOW_TEST_RESET_TOKEN="false"

# Local development only
# DATABASE_URL="pglite:.data/intellischedule"

# Runtime configuration
NODE_ENV="development"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="https://tiet-timetable-six.vercel.app,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# PostgreSQL. In production use the Supabase Postgres connection string.
DATABASE_URL="postgresql://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres"
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nCHANGE_ME\n-----END CERTIFICATE-----"
PG_POOL_MAX="5"

# Authentication
ALLOWED_EMAIL_DOMAINS="thapar.edu"
BCRYPT_ROUNDS="12"
SESSION_TTL_HOURS="24"
SESSION_IDLE_MINUTES="240"
SESSION_ABSOLUTE_HOURS="24"
LOGIN_RATE_LIMIT_PER_IP="300"

# Optional development/test seed data. Never rely on sample/demo defaults in production.
SEED_SAMPLE_USERS="false"
SAMPLE_ACCOUNTS_PASSWORD=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME="Administrator"
BOOTSTRAP_ADMIN_PASSWORD=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Password reset delivery
MAILER_SERVICE_URL=""
MAILER_SERVICE_TOKEN=""

# Test-only reset visibility; keep false outside controlled test runs.
ALLOW_TEST_RESET_TOKEN="false"

# Proxy/runtime
TRUST_PROXY="1"
TIMETABLE_JOB_TIMEOUT_MS="120000"

# Optional Gemini integration
GEMINI_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Production PostgreSQL & Backend Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-side-service-role-key"
SUPABASE_DB_CONNECTION_STRING="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# Google Workspace OAuth 2.0 Credentials (REQUIRES HUMAN ACTION in deployment)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Allowed email domains for institutional signup and Google OAuth (comma-separated, without @)
ALLOWED_EMAIL_DOMAINS="thapar.edu"

# Public demo accounts configuration
# PUBLIC_DEMO_ENABLED: Must be explicitly 'true' to enable demo endpoints (/api/demo/status, /api/auth/demo-login)
PUBLIC_DEMO_ENABLED="false"
# ALLOW_DEMO_IN_PRODUCTION: Must be 'true' to permit demo accounts in NODE_ENV=production (admin/coordinator roles blocked)
ALLOW_DEMO_IN_PRODUCTION="false"
# DEMO_ACCOUNT_PASSWORD: Password for seeded demo accounts (randomly generated at startup if unset)
DEMO_ACCOUNT_PASSWORD="ChangeMeInDev123!"

# Seed user accounts configuration (Non-production development only)
# SEED_USER_PASSWORD: Password for seeded development accounts (randomly generated at startup if unset; never seeded in production)
SEED_USER_PASSWORD="ChangeMeInDev123!"

# Testing & Security Settings
# ALLOW_TEST_RESET_TOKEN: Only enabled in test environment to allow verification of reset flow; never in production
ALLOW_TEST_RESET_TOKEN="false"

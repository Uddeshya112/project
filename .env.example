# Copy to .env for local runs. In production set these as environment variables / secrets.

# --- Database (required in production) --------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string. On Cloud Run / serverless use the
# "Transaction pooler" URI (port 6543). Locally you can leave this unset: development uses an
# embedded Postgres in ./.data (DATABASE_URL=pglite:./.data/pglite).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Supabase CA certificate (Database settings -> SSL -> Download certificate), PEM text with \n for
# newlines. When set, the server verifies the database's TLS certificate.
DATABASE_SSL_CA=""
PG_POOL_MAX=5

# --- Public URL ------------------------------------------------------------------------------
# The address users open, e.g. https://timetable.thapar.edu (used for Google redirects).
APP_URL="http://localhost:3000"
PORT=3000
# Number of proxy hops in front of the app (Cloud Run / Render / nginx: 1). Needed for correct
# client IPs (rate limiting) and secure cookies.
TRUST_PROXY=1

# --- Sign-in ---------------------------------------------------------------------------------
# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, Web).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only these email domains may use Google sign-in (comma separated).
ALLOWED_EMAIL_DOMAINS="thapar.edu"
SESSION_TTL_HOURS=168

# Optional first administrator, created on start if missing. Without a password the admin signs
# in with Google (must be in ALLOWED_EMAIL_DOMAINS).
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Timetable Administrator"

# --- Sample / demo data ------------------------------------------------------------------------
# One-click demo logins on the sign-in page. Anyone can then act as the demo Coordinator/Admin,
# so set to false once real data is in use.
DEMO_MODE=true
# On first start with an empty database, load the sample academic dataset and sample accounts.
SEED_DEMO_DATA=true
SEED_SAMPLE_USERS=true
# Initial passwords for the sample accounts (only applied when they are first created).
SAMPLE_ACCOUNTS_PASSWORD="ThaparInstitute@2026!"
DEMO_ACCOUNTS_PASSWORD="ThaparDemo@2026Test!"

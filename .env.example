# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL for this deployment. Use the production app URL here, not the demo URL.
APP_URL="https://your-production-app.example"
ALLOWED_ORIGINS="https://your-production-app.example"

# Supabase Production PostgreSQL & Backend Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-side-service-role-key"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@your-project-pooler:6543/postgres"
# Required with Supabase: its certificate is not in the default trust store, and unverified connections are refused.
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----"
PG_POOL_MAX="5"

# Google Workspace OAuth 2.0 Credentials (REQUIRES HUMAN ACTION in deployment)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Allowed email domains for institutional signup and Google OAuth (comma-separated, without @)
ALLOWED_EMAIL_DOMAINS="thapar.edu"

# Real production app: keep public demos off and use a separate Supabase project from the presentation app.
PUBLIC_DEMO_ENABLED="false"
ALLOW_DEMO_IN_PRODUCTION="false"
SEED_DEMO_DATA="false"
SEED_SAMPLE_USERS="false"

# One-time administrator bootstrap for a new, empty real production database.
# Store BOOTSTRAP_ADMIN_PASSWORD in the host's secret manager and remove it after first successful start.
BOOTSTRAP_ADMIN_EMAIL="admin@example.edu"
BOOTSTRAP_ADMIN_NAME="Initial Institution Administrator"
BOOTSTRAP_ADMIN_PASSWORD="replace-through-secret-manager"

# Non-production seeded staff accounts only.
SEED_USER_PASSWORD=""

# Optional email delivery. Email-dependent functions remain unavailable without a provider.
SMTP_URL=""
SMTP_FROM=""

# Number of proxies in front of the server. Without it every visitor behind the proxy shares one login rate limit.
# 1 for Render alone; 2 when Vercel forwards /api to Render.
TRUST_PROXY="1"

# Testing & Security Settings
# ALLOW_TEST_RESET_TOKEN: Only enabled in test environment to allow verification of reset flow; never in production
ALLOW_TEST_RESET_TOKEN="false"
